# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
SCORING_TIMEOUT_MS=90

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# ── Redis (online feature store) ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_FEATURE_TTL=86400

# ── ClickHouse (offline feature store) ───────────────────────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_DATABASE=fraudtrap
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ── Postgres (metadata) ───────────────────────────────────────────────────────
POSTGRES_URL=postgresql://fraudtrap:fraudtrap@localhost:5432/fraudtrap

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ── Scoring thresholds ────────────────────────────────────────────────────────
SCORE_BLOCK_THRESHOLD=0.85
SCORE_REVIEW_LOW=0.40
SCORE_REVIEW_HIGH=0.85

# ── Privacy / Differential Privacy ───────────────────────────────────────────
DP_EPSILON=10.0
DP_DELTA=1e-5

# ── Label pipeline ────────────────────────────────────────────────────────────
LABEL_LAG_DAYS=70

# ── TabPFN (Adaptive Learning) ────────────────────────────────────────────────
# License token from https://priorlabs.ai — required for TabPFN model weights
TABPFN_TOKEN=
