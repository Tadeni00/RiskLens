{
  "info": {
    "name": "FraudTrap API",
    "description": "Production-grade fraud detection API for banks and fintechs",
    "_postman_id": "fraudtrap-api-collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{api_key}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "api_key",
      "value": "your-api-key-here",
      "type": "string"
    },
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Scoring",
      "item": [
        {
          "name": "POST /v1/score — Score Transaction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant_id\": \"bank_ng_gtb\",\n  \"account_id\": \"tok_acct_123\",\n  \"amount\": 45000,\n  \"currency\": \"NGN\",\n  \"timestamp\": \"2026-07-20T14:30:00Z\",\n  \"transaction_type\": \"PAYMENT\",\n  \"channel\": \"MOBILE\",\n  \"counterparty\": {\n    \"name\": \"QuickStore Ltd\",\n    \"country\": \"NG\"\n  },\n  \"metadata\": {\n    \"device_id\": \"dev_abc123\",\n    \"ip_address\": \"105.112.33.44\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/score",
              "host": ["{{base_url}}"],
              "path": ["v1", "score"]
            },
            "description": "Score a single transaction for fraud risk"
          }
        },
        {
          "name": "POST /v1/score/batch — Batch Score",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"tenant_id\": \"bank_ng_gtb\",\n    \"account_id\": \"tok_acct_123\",\n    \"amount\": 45000,\n    \"currency\": \"NGN\",\n    \"timestamp\": \"2026-07-20T14:30:00Z\",\n    \"transaction_type\": \"PAYMENT\",\n    \"channel\": \"MOBILE\"\n  },\n  {\n    \"tenant_id\": \"bank_ng_gtb\",\n    \"account_id\": \"tok_acct_456\",\n    \"amount\": 120000,\n    \"currency\": \"NGN\",\n    \"timestamp\": \"2026-07-20T14:31:00Z\",\n    \"transaction_type\": \"TRANSFER\",\n    \"channel\": \"USSD\"\n  },\n  {\n    \"tenant_id\": \"bank_ng_gtb\",\n    \"account_id\": \"tok_acct_789\",\n    \"amount\": 5000,\n    \"currency\": \"NGN\",\n    \"timestamp\": \"2026-07-20T14:32:00Z\",\n    \"transaction_type\": \"WITHDRAWAL\",\n    \"channel\": \"ATM\"\n  }\n]"
            },
            "url": {
              "raw": "{{base_url}}/v1/score/batch",
              "host": ["{{base_url}}"],
              "path": ["v1", "score", "batch"]
            },
            "description": "Score multiple transactions in a single request"
          }
        }
      ]
    },
