                  "raw": "{\n  \"id\": \"velocity_high_amount\",\n  \"description\": \"High amount velocity\",\n  \"type\": \"velocity\",\n  \"action\": \"REVIEW\",\n  \"severity\": \"high\",\n  \"conditions\": {\n    \"field\": \"amount\",\n    \"operator\": \"gt\",\n    \"value\": 100000,\n    \"window_minutes\": 60,\n    \"threshold\": 3\n  },\n  \"enabled\": true,\n  \"tenant_id\": \"bank_ng_gtb\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/v1/admin/rules",
                  "host": ["{{base_url}}"],
                  "path": ["v1", "admin", "rules"]
                },
                "description": "Create a new fraud detection rule"
              }
            },
            {
