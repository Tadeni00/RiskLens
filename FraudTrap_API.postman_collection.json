              "request": {
                "method": "DELETE",
                "url": {
                  "raw": "{{base_url}}/v1/admin/rules/velocity_high_amount",
                  "host": ["{{base_url}}"],
                  "path": ["v1", "admin", "rules", ":rule_id"],
                  "variable": [
                    {
                      "key": "rule_id",
                      "value": "velocity_high_amount",
                      "description": "Rule identifier"
                    }
                  ]
                },
                "description": "Delete a fraud detection rule"
